# Caddy fronts the whole stack. PUBLIC_URL is a full address, which decides the
# protocol on its own: given https://... Caddy obtains and renews a Let's Encrypt
# certificate by itself, given http://<ip> it just serves plain HTTP.
#
# The site and the API share one origin. That is not a detail — the refresh token
# lives in an httpOnly cookie, and same-origin means no CORS setup and no
# third-party-cookie problems inside the Telegram Mini App webview.

{$PUBLIC_URL} {
	encode zstd gzip

	# Certificates are obtained over TLS-ALPN on 443 instead of the usual HTTP
	# challenge on 80. That port is often already taken on a shared server, and
	# insisting on it would mean rearranging whatever is already listening there.
	tls {
		issuer acme {
			disable_http_challenge
		}
	}

	# Nothing here is loaded from telegram.org: that host is blocked for most of
	# the club, so the Mini App SDK is served from /vendor and player photos are
	# re-served by the API.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv

		# SPA HTML is requested as `/`, `/rating`, … — not as `/index.html`.
		# Telegram's Mini App webview caches that document aggressively.
		@html {
			not path /assets/*
			not path /vendor/*
		}
		header @html Cache-Control "no-store, no-cache, must-revalidate"
		@sw path /sw.js /sw.js.map /workbox-* /registerSW.js /manifest.webmanifest
		header @sw Cache-Control "no-store, no-cache, must-revalidate"
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		# Vendored third-party scripts have no hash in their name, so they get a
		# day rather than a year: long enough to stop re-downloading 113 kB on
		# every visit, short enough that replacing the file actually lands.
		@vendor path /vendor/*
		header @vendor Cache-Control "public, max-age=86400"

		# Client-side routing: unknown paths are React Router's business, not 404s.
		try_files {path} /index.html
		file_server
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 20mb
			roll_keep 5
		}
	}
}
