# Production configuration. Copy to infra/.env on the server and fill it in.
#
#   cp .env.example .env
#
# This file is read by docker compose only — the applications themselves receive
# their settings through the environment defined in docker-compose.yml.

# ─── Public address ────────────────────────────────────────────────────────────
# A full URL including the protocol. It is the single source of truth: Caddy binds
# it, the API allows it as an origin, and the bot's buttons link to it.
#
# With no domain of your own, use the server's IP through sslip.io — a public
# wildcard DNS service that resolves the address embedded in the name. It is a
# real hostname, so Let's Encrypt issues a real certificate for it, and that is
# what makes Telegram login work at all: Telegram refuses to sign users in over
# plain HTTP or to a bare IP address.
PUBLIC_URL="https://147-45-224-200.sslip.io"

# Plain HTTP on the IP also works, but then Telegram login is unavailable and
# only the development sign-in does — fine for a first look at the interface:
# PUBLIC_URL="http://147.45.224.200"

# ─── Ports on the host ─────────────────────────────────────────────────────────
# Change these only if something else already listens there. 443 is the one that
# must stay reachable from the internet: certificates are issued over TLS-ALPN,
# so port 80 is not needed at all and can be moved out of the way.
HTTP_PORT=80
HTTPS_PORT=443

# ─── Database ──────────────────────────────────────────────────────────────────
# Postgres is not published to the host, so this password only guards the
# internal network — still, generate it rather than inventing one.
POSTGRES_USER="poker"
POSTGRES_PASSWORD="CHANGE_ME"
POSTGRES_DB="poker_league"

# ─── Secrets ───────────────────────────────────────────────────────────────────
# Generate each one separately:  openssl rand -hex 32
#
# JWT_SECRET signs access tokens: replacing it logs everybody out.
# INTERNAL_API_TOKEN is what the bot presents to act on a player's behalf —
# treat it like a master key and never put it in a client or a chat message.
JWT_SECRET="CHANGE_ME_64_HEX_CHARACTERS"
INTERNAL_API_TOKEN="CHANGE_ME_64_HEX_CHARACTERS"

# Access token lifetime in seconds (15 minutes) and refresh token (30 days).
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# ─── Telegram ──────────────────────────────────────────────────────────────────
# From @BotFather. The username has no leading @.
#
# Two BotFather settings are required on top of this, and login fails silently
# without them — see infra/README.md:
#   /setdomain      → the host from PUBLIC_URL, without the protocol
#   /newapp         → Mini App pointing at PUBLIC_URL
#
# Leave both empty for a first deploy: the site and the API start fine, and only
# the bot container stays down. Fill them in and re-run `docker compose up -d`.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
