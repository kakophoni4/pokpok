# Copy to .env and fill in. .env is gitignored — never commit real tokens.

NODE_ENV=development

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:CHANGE_ME@127.0.0.1:5432/poker_league?schema=public"
# Prisma needs a throwaway database to diff migrations against.
SHADOW_DATABASE_URL="postgresql://postgres:CHANGE_ME@127.0.0.1:5432/poker_league_shadow?schema=public"

# ─── API ───────────────────────────────────────────────────────────────────────
API_PORT=3000
# openssl rand -hex 48   (or any 64+ random chars)
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
# Comma-separated list of origins allowed to call the API with credentials.
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
PUBLIC_WEB_URL="http://localhost:5173"
PUBLIC_API_URL="http://127.0.0.1:3000"

# Shared secret for /api/auth/internal/* — the endpoints the bots use to trade a
# Telegram/VK identity for a normal user session. Must never leave the server
# network. openssl rand -hex 32
INTERNAL_API_TOKEN="CHANGE_ME_TO_A_LONG_RANDOM_STRING"

# ─── Telegram ──────────────────────────────────────────────────────────────────
# From @BotFather. Used to verify Login Widget hashes and Mini App initData,
# so the API and the bot must share the exact same token.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
# Long polling in dev; set a public https URL to switch the bot to webhooks.
TELEGRAM_WEBHOOK_URL=""

# ─── VK (phase 2) ──────────────────────────────────────────────────────────────
VK_CLIENT_ID=""
VK_CLIENT_SECRET=""
VK_SERVICE_TOKEN=""
VK_GROUP_ID=""
VK_CALLBACK_SECRET=""

# ─── Web (Vite: only VITE_* reaches the browser bundle) ────────────────────────
# Leave empty. The web app then calls the API at the relative path /api, which
# the Vite dev server (and the production reverse proxy) forwards to the API.
# Same origin means the httpOnly refresh cookie just works, with no CORS setup.
# Only set this if the frontend is hosted on a different domain — and then it
# must include the /api suffix, e.g. https://api.example.com/api
VITE_API_URL=""
VITE_TELEGRAM_BOT_USERNAME=""
