// Poker league schema.
//
// Two ideas drive this model:
//   1. A user is one person with many provider identities (Telegram, VK), so
//      logging in from a different platform never creates a duplicate player.
//   2. Rating is never stored as a mutable number. Every point a player owns
//      comes from a row in RatingEvent, which makes the whole standings table
//      explainable, auditable and recomputable after a correction.
//
// Enums here mirror packages/contracts/src/enums.ts.

// Prisma 7: connection URLs live in prisma.config.ts, not here.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  telegram
  vk
}

enum UserRole {
  player
  hostess
  admin
}

enum UserStatus {
  active
  blocked
}

enum TournamentStatus {
  draft
  announced
  reg_open
  reg_closed
  running
  finished
  cancelled
}

enum RegistrationStatus {
  registered
  waitlist
  cancelled
}

/// What the club took money for. Entry and add-on also hand out chips, which is
/// what the rating is computed from; a drink is money only.
enum PaymentKind {
  entry
  rebuy
  addon
  drink
  other
}

enum RegistrationSource {
  web
  miniapp
  tg_bot
  vk_bot
  admin
}

/// A login waiting on the bot. Expiry is a timestamp, not a state, so a ticket
/// nobody ever answered needs no sweeper to move it along.
enum LoginTicketState {
  pending
  confirmed
  declined
}

enum RatingSourceType {
  tournament_result
  achievement
  manual_adjustment
  penalty
}

model User {
  id                     String     @id @default(cuid(2))
  nickname               String     @unique
  displayName            String?
  avatarUrl              String?
  role                   UserRole   @default(player)
  status                 UserStatus @default(active)
  notifyBeforeTournament Boolean    @default(true)
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  identities          Identity[]
  sessions            Session[]
  linkTokens          LinkToken[]
  loginTickets        LoginTicket[]
  registrations       Registration[]
  results             Result[]
  payments            Payment[]
  authoredPayments    Payment[]         @relation("paymentAuthor")
  voidedPayments      Payment[]         @relation("paymentVoider")
  ratingEvents        RatingEvent[]
  seasonStats         UserSeasonStats[]
  achievements        UserAchievement[] @relation("achievementHolder")
  grantedAchievements UserAchievement[] @relation("achievementGranter")
  auditEntries        AuditLog[]
  notifications       Outbox[]

  @@index([role])
  @@index([status])
}

/// One row per external account bound to a user. Adding VK later means adding
/// rows here, not touching User.
model Identity {
  id               String       @id @default(cuid(2))
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider         AuthProvider
  providerUserId   String
  providerUsername String?
  /// Untouched provider payload, kept for debugging and for backfilling new fields.
  raw              Json?
  createdAt        DateTime     @default(now())

  @@unique([provider, providerUserId])
  @@index([userId])
}

/// Refresh-token sessions. Only the hash is stored, so a database leak cannot
/// be replayed as a login.
model Session {
  id        String    @id @default(cuid(2))
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  audience  String
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// One-time token that lets a logged-in user attach a second provider by
/// following a bot deep link.
model LinkToken {
  id        String       @id @default(cuid(2))
  token     String       @unique
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  AuthProvider
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  @@index([userId])
}

/// A browser waiting for a tap in Telegram.
///
/// The site opens one of these, sends the visitor into the bot with `code` in the
/// deep link, and polls until the bot marks it confirmed. `userId` is filled in
/// at that moment, which is also when we learn who was logging in at all.
model LoginTicket {
  id        String           @id @default(cuid(2))
  code      String           @unique
  /// Shown on both screens so a forwarded link cannot be confirmed by mistake.
  phrase    String
  state     LoginTicketState @default(pending)
  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  /// Set when the session is handed to the browser; makes the ticket single-use.
  usedAt    DateTime?
  createdAt DateTime         @default(now())
  ip        String?
  userAgent String?

  @@index([userId])
  @@index([expiresAt])
}

model Season {
  id        String    @id @default(cuid(2))
  title     String    @unique
  startsAt  DateTime
  endsAt    DateTime?
  isActive  Boolean   @default(false)
  /// RatingConfig from @poker/contracts. Tunable without a deploy.
  ratingConfig Json
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tournaments  Tournament[]
  ratingEvents RatingEvent[]
  stats        UserSeasonStats[]

  @@index([isActive])
}

model Venue {
  id        String   @id @default(cuid(2))
  title     String
  address   String?
  geoLat    Float?
  geoLon    Float?
  createdAt DateTime @default(now())

  tournaments Tournament[]
}

model Tournament {
  id               String           @id @default(cuid(2))
  seasonId         String?
  season           Season?          @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  venueId          String?
  venue            Venue?           @relation(fields: [venueId], references: [id], onDelete: SetNull)
  title            String
  description      String?
  startsAt         DateTime
  regOpensAt       DateTime?
  regClosesAt      DateTime?
  capacity         Int?
  /// Null on all three means "use the season's rating config". Kept per
  /// tournament because the paid-place count changes while the game is running.
  paidPlaces       Int?
  startingStack    Int?
  addonChips       Int?
  /// Weight of the event: 1 for a regular game, 2 for a major.
  ratingMultiplier Float            @default(1)
  /// If set, a player needs at least this many season points to sign up.
  minRating        Int?
  status           TournamentStatus @default(draft)
  /// Forum topic in the admin supergroup and the pinned summary inside it, so
  /// the bot edits the same screens instead of posting new ones.
  adminTopicId     Int?
  adminBoardMsgId  Int?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  registrations Registration[]
  results       Result[]
  payments      Payment[]
  ratingEvents  RatingEvent[]
  achievements  UserAchievement[]

  @@index([startsAt])
  @@index([status, startsAt])
  @@index([seasonId])
}

model Registration {
  id               String             @id @default(cuid(2))
  tournamentId     String
  tournament       Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           RegistrationStatus @default(registered)
  source           RegistrationSource @default(web)
  /// Set only while the player waits for a seat; null once promoted.
  waitlistPosition Int?
  /// The player's card in the game's topic. Stored so the bot edits that message
  /// rather than posting a new one on every action at the cash desk.
  adminCardMsgId   Int?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([tournamentId, userId])
  @@index([tournamentId, status])
  @@index([userId])
}

/// Final standings. The place uniqueness constraint makes a corrupted table
/// impossible at the database level, not just in application code.
model Result {
  id           String     @id @default(cuid(2))
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  place        Int
  createdAt    DateTime   @default(now())

  @@unique([tournamentId, userId])
  @@unique([tournamentId, place])
  @@index([userId])
}

/// The cash desk. Every line the admin registers during the evening lands here:
/// entry, add-on, drink. Two jobs at once — it is the club's takings report, and
/// it is what participation means, since whoever paid an entry played.
///
/// Nothing is ever edited or deleted. A mistake is voided, which keeps the
/// original line visible and makes any evening reconstructable afterwards.
model Payment {
  id           String      @id @default(cuid(2))
  tournamentId String
  tournament   Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         PaymentKind
  amountRub    Int
  /// Chips this line handed out, copied in at the time: later changes to the
  /// stack size must not silently rewrite a finished evening.
  chips        Int         @default(0)
  note         String?
  createdById  String?
  createdBy    User?       @relation("paymentAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  voidedAt     DateTime?
  voidedById   String?
  voidedBy     User?       @relation("paymentVoider", fields: [voidedById], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())

  @@index([tournamentId, userId])
  @@index([userId])
  @@index([createdAt])
}

/// Club-wide settings, exactly one row. The timezone lives here because it is
/// what every date shown to a human is rendered in, on the site and in the bot.
model ClubSettings {
  id            String   @id @default("club")
  infoText      String   @default("")
  entryPriceRub Int      @default(500)
  rebuyPriceRub Int      @default(500)
  addonPriceRub Int      @default(500)
  drinkPriceRub Int      @default(200)
  /// Supergroup the bot runs the live admin screens in.
  adminChatId   String?
  timezone      String   @default("Europe/Samara")
  updatedAt     DateTime @updatedAt
}

/// Cash-desk buttons: the three fixed kinds (вход / адон / ребай) cannot be
/// deleted. Everything else is an extra SKU or a promo the admin added.
model ClubMenuItem {
  id        String      @id @default(cuid(2))
  title     String
  kind      PaymentKind
  priceRub  Int         @default(0)
  /// Extra chips this line hands out. 0 means "use the tournament stack".
  chips     Int         @default(0)
  isFixed   Boolean     @default(false)
  isPromo   Boolean     @default(false)
  isActive  Boolean     @default(true)
  sortOrder Int         @default(0)
  /// Promo contents: [{kind, quantity, menuItemId?, title?}]. Null = legacy single kind.
  bundle    Json?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([sortOrder])
}

model Achievement {
  id           String   @id @default(cuid(2))
  code         String   @unique
  title        String
  description  String?
  icon         String?
  ratingPoints Int      @default(0)
  isActive     Boolean  @default(true)
  isRepeatable Boolean  @default(false)
  /// AchievementRule from @poker/contracts; null means "granted by hand".
  rule         Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  holders      UserAchievement[]
  ratingEvents RatingEvent[]
}

model UserAchievement {
  id            String      @id @default(cuid(2))
  userId        String
  user          User        @relation("achievementHolder", fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  tournamentId  String?
  tournament    Tournament? @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  grantedById   String?
  grantedBy     User?       @relation("achievementGranter", fields: [grantedById], references: [id], onDelete: SetNull)
  comment       String?
  grantedAt     DateTime    @default(now())

  /// Empty string for one-off achievements, which makes the unique constraint
  /// below reject a second grant. Repeatable ones pass a distinct key per grant.
  dedupeKey String @default("")

  ratingEvents RatingEvent[]

  @@unique([userId, achievementId, dedupeKey])
  @@index([userId])
  @@index([achievementId])
}

/// Append-only ledger. Corrections are made by deleting the events of one
/// tournament and re-inserting them inside a transaction, never by editing totals.
model RatingEvent {
  id                String           @id @default(cuid(2))
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  seasonId          String?
  season            Season?          @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  sourceType        RatingSourceType
  points            Int
  comment           String?
  tournamentId      String?
  tournament        Tournament?      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  /// Denormalised copies so history rows render without extra joins.
  place             Int?
  fieldSize         Int?
  achievementId     String?
  achievement       Achievement?     @relation(fields: [achievementId], references: [id], onDelete: SetNull)
  userAchievementId String?
  userAchievement   UserAchievement? @relation(fields: [userAchievementId], references: [id], onDelete: Cascade)
  createdBy         String?
  createdAt         DateTime         @default(now())

  @@index([userId, seasonId])
  @@index([tournamentId])
  @@index([createdAt])
}

/// Cached projection of RatingEvent, refreshed whenever events change.
/// Deleting this table entirely must never lose data.
model UserSeasonStats {
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  seasonId    String
  season      Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  points      Int      @default(0)
  gamesPlayed Int      @default(0)
  wins        Int      @default(0)
  top3        Int      @default(0)
  itm         Int      @default(0)
  avgPlace    Float?
  bestPlace   Int?
  updatedAt   DateTime @updatedAt

  @@id([userId, seasonId])
  @@index([seasonId, points(sort: Desc)])
}

model AuditLog {
  id       String   @id @default(cuid(2))
  actorId  String?
  actor    User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action   String
  entity   String
  entityId String?
  before   Json?
  after    Json?
  ip       String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

/// Outbound notifications. Written in the same transaction as the change that
/// triggers them, delivered later by the worker, so nothing is lost on restart.
model Outbox {
  id          String       @id @default(cuid(2))
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel     AuthProvider
  kind        String
  payload     Json
  /// Guards against duplicate reminders when the worker retries.
  dedupeKey   String
  scheduledAt DateTime
  sentAt      DateTime?
  attempts    Int          @default(0)
  lastError   String?
  createdAt   DateTime     @default(now())

  @@unique([userId, kind, dedupeKey])
  @@index([sentAt, scheduledAt])
}
